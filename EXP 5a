USE School;

-- ======================================
-- CREATE TABLE
-- ======================================

CREATE TABLE Student
(
    RollNo INT PRIMARY KEY,
    Name VARCHAR(50),
    Physics INT,
    Chemistry INT,
    Mathematics INT
);

