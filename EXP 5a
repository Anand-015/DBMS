-- DISPLAY TABLE
SELECT * FROM Student;

-- ======================================
-- 1. Class average for Physics
-- ======================================

SELECT AVG(Physics) AS Avg_Physics
FROM Student;

-- ======================================
-- 2. Highest mark in Mathematics
-- ======================================

SELECT MAX(Mathematics) AS highest_mark_maths
FROM Student;

-- ======================================
-- 3. Lowest marks for Chemistry
-- ======================================

SELECT MIN(Chemistry) AS lowest_mark_chemistry
FROM Student;

-- ======================================
-- 4. Total students passed in Physics
-- Pass mark = 12
-- ======================================

SELECT COUNT(*) AS Pass_Physics
FROM Student
WHERE Physics >= 12;

-- ======================================
-- 5. Students passed in all subjects
-- Physics >=12
-- Chemistry >=12
-- Mathematics >=25
-- ======================================

SELECT *
FROM Student
WHERE Physics >= 12
AND Chemistry >= 12
AND Mathematics >= 25;

-- ======================================
-- 6. Rank list with Pass/Fail
-- ======================================

SELECT
Name,
(Physics + Chemistry + Mathematics) AS Total,
CASE
    WHEN Physics >= 12
    AND Chemistry >= 12
    AND Mathematics >= 25
    THEN 'PASS'
    ELSE 'FAIL'
END AS Result
FROM Student
ORDER BY Total DESC;

-- ======================================
-- 7. Pass percentage for all classes
-- ======================================

SELECT
(COUNT(
    CASE
        WHEN Physics >=12
        AND Chemistry >=12
        AND Mathematics >=25
        THEN 1
    END
) * 100.0 / COUNT(*)) AS Pass_Percentage
FROM Student;

-- ======================================
-- 8. Pass percentage in Mathematics
-- ======================================

SELECT
(COUNT(
    CASE
        WHEN Mathematics >=25
        THEN 1
    END
) * 100.0 / COUNT(*)) AS Maths_Pass_Percentage
FROM Student;

-- ======================================
-- 9. Class average
-- ======================================

SELECT
AVG((Physics + Chemistry + Mathematics)/3.0)
AS Class_Average
FROM Student;

-- ======================================
-- 10. Total students passed
-- ======================================

SELECT COUNT(*) AS Total_Passed
FROM Student
WHERE Physics >=12
AND Chemistry >=12
AND Mathematics >=25;
