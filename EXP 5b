-- ======================================
-- DISPLAY TABLES
-- ======================================

SELECT * FROM Items;
SELECT * FROM Customers;
SELECT * FROM Orders;
SELECT * FROM Delivery;

-- ======================================
-- 1. Customers who placed an order
-- ======================================

SELECT DISTINCT Customers.*
FROM Customers
JOIN Orders
ON Customers.CustId = Orders.CustId;

-- ======================================
-- 2. Customers whose orders delivered
-- ======================================

SELECT DISTINCT Customers.*
FROM Customers
JOIN Delivery
ON Customers.CustId = Delivery.CustId;

-- ======================================
-- 3. Order date for customers
-- whose name starts with J
-- ======================================

SELECT Orders.OrderDate
FROM Orders
JOIN Customers
ON Orders.CustId = Customers.CustId
WHERE Customers.CustName LIKE 'J%';

-- ======================================
-- 4. Item name and price bought by Mickey
-- ======================================

SELECT Items.ItemName, Items.Price
FROM Items
JOIN Orders
ON Items.ItemId = Orders.ItemId
JOIN Customers
ON Orders.CustId = Customers.CustId
WHERE Customers.CustName = 'Mickey';

-- ======================================
-- 5. Customers placed order after Jan 2015
-- and not received delivery
-- ======================================

SELECT DISTINCT Customers.*
FROM Customers
JOIN Orders
ON Customers.CustId = Orders.CustId
WHERE Orders.OrderDate > '2015-01-01'
AND Customers.CustId NOT IN
(
    SELECT CustId
    FROM Delivery
);

-- ======================================
-- 6. Items ordered or not delivered
-- using UNION
-- ======================================

SELECT ItemName
FROM Items
WHERE ItemId IN
(
    SELECT ItemId
    FROM Orders
)

UNION

SELECT ItemName
FROM Items
WHERE ItemId NOT IN
(
    SELECT Orders.ItemId
    FROM Orders
    JOIN Delivery
    ON Orders.OrderId = Delivery.OrderId
);

-- ======================================
-- 7. Customers placed order but
-- not delivered using MINUS logic
-- ======================================

SELECT CustName
FROM Customers
WHERE CustId IN
(
    SELECT CustId FROM Orders
)

AND CustId NOT IN
(
    SELECT CustId FROM Delivery
);

-- ======================================
-- 8. Customers placed order and delivered
-- using INTERSECT logic
-- ======================================

SELECT CustName
FROM Customers
WHERE CustId IN
(
    SELECT CustId FROM Orders
)

AND CustId IN
(
    SELECT CustId FROM Delivery
);

-- ======================================
-- 9. Customer with most orders
-- ======================================

SELECT Customers.CustName
FROM Customers
JOIN Orders
ON Customers.CustId = Orders.CustId
GROUP BY Customers.CustName
ORDER BY COUNT(*) DESC
LIMIT 1;

-- ======================================
-- 10. Customers purchased items
-- exceeding 5000
-- ======================================

SELECT DISTINCT Customers.*
FROM Customers
JOIN Orders
ON Customers.CustId = Orders.CustId
JOIN Items
ON Orders.ItemId = Items.ItemId
WHERE Items.Price > 5000;

-- ======================================
-- 11. Customers who did not order
-- Samsung Galaxy S4
-- ======================================

SELECT CustName, Address
FROM Customers
WHERE CustId NOT IN
(
    SELECT Orders.CustId
    FROM Orders
    JOIN Items
    ON Orders.ItemId = Items.ItemId
    WHERE Items.ItemName = 'Samsung Galaxy S4'
);

-- ======================================
-- 12. LEFT OUTER JOIN
-- ======================================

SELECT *
FROM Customers
LEFT JOIN Orders
ON Customers.CustId = Orders.CustId;

-- ======================================
-- 13. RIGHT OUTER JOIN
-- ======================================

SELECT *
FROM Customers
RIGHT JOIN Orders
ON Customers.CustId = Orders.CustId;

-- ======================================
-- 14. Customers grouped by state
-- ======================================

SELECT State, COUNT(*) AS Total_Customers
FROM Customers
GROUP BY State;

-- ======================================
-- 15. Items grouped by category
-- having price greater than average
-- ======================================

SELECT Category, AVG(Price) AS AvgPrice
FROM Items
GROUP BY Category
HAVING AVG(Price) >
(
    SELECT AVG(Price)
    FROM Items
);
